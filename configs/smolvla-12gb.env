# RTX 5070 Ti Laptop 12GB 的参考值。
# 本文件不会被 activate-train.sh 或 lerobot-train 自动读取；正式命令见
# docs/TRAINING.md。LeRobot 0.6 当前没有梯度累积 CLI 参数。

SMOLVLA_BASE_MODEL=lerobot/smolvla_base
SMOLVLA_DEVICE=cuda
SMOLVLA_DTYPE=bfloat16
SMOLVLA_BATCH_SIZE=1
SMOLVLA_FREEZE_VISION_ENCODER=true
SMOLVLA_TRAIN_EXPERT_ONLY=true
SMOLVLA_NUM_WORKERS=4
